# =====================================================================
#  Plataforma Inteligente de Soporte Técnico - variables de entorno
#  Copia este archivo a .env y CAMBIA todos los valores "cambia-*".
#  Nunca subas el archivo .env a Git.
# =====================================================================

# --- Acceso web -------------------------------------------------------
# Puerto local donde Nginx sirve la aplicación (http://localhost:8080)
HTTP_PORT=8080
# Dominio público (solo si usas Cloudflare Tunnel con nombre)
PUBLIC_DOMAIN=soporte.midominio.com
# Orígenes permitidos para CORS (separados por coma)
CORS_ORIGINS=http://localhost:8080,https://soporte.midominio.com
# true cuando la app se sirve por HTTPS (Cloudflare). Marca la cookie como Secure.
COOKIE_SECURE=false

# --- PostgreSQL ---------------------------------------------------------
POSTGRES_PASSWORD=cambia-postgres
HELPDESK_DB_PASSWORD=cambia-helpdesk-db
AIRFLOW_DB_PASSWORD=cambia-airflow-db
LAKE_DB_PASSWORD=cambia-lake-db
LAKE_READER_PASSWORD=cambia-lake-reader

# --- RabbitMQ -----------------------------------------------------------
RABBITMQ_USER=helpdesk
RABBITMQ_PASSWORD=cambia-rabbit

# --- SeaweedFS (S3) -----------------------------------------------------
S3_ADMIN_ACCESS_KEY=admin
S3_ADMIN_SECRET_KEY=cambia-s3-admin
S3_HELPDESK_ACCESS_KEY=helpdesk
S3_HELPDESK_SECRET_KEY=cambia-s3-helpdesk
S3_AI_ACCESS_KEY=ai
S3_AI_SECRET_KEY=cambia-s3-ai
S3_LAKE_ACCESS_KEY=lake
S3_LAKE_SECRET_KEY=cambia-s3-lake

# --- Seguridad de la aplicación -----------------------------------------
# Secreto de firma JWT (HS256). Mínimo 32 caracteres aleatorios.
JWT_SECRET=cambia-este-secreto-jwt-de-al-menos-32-caracteres
# Clave compartida para llamadas internas entre servicios (no pasa por Nginx)
SERVICE_KEY=cambia-clave-interna-servicios
# Administrador inicial (se crea en el primer arranque si no existe)
ADMIN_EMAIL=admin@helpdesk.local
ADMIN_PASSWORD=Admin123!cambia
# Sal para seudonimizar identificadores de usuario en el Data Lake
PSEUDONYM_SALT=cambia-sal-seudonimos
# Habilita el generador de escenarios de demostración (datos marcados es_demo)
DEMO_ENABLED=true

# --- Inteligencia artificial --------------------------------------------
# heuristic : reglas locales, sin modelo (funciona sin GPU ni internet)
# openai    : cualquier API compatible con OpenAI (OpenAI, Groq, OpenRouter, etc.)
# ollama    : modelo local servido por Ollama (perfil "ollama" de compose)
LLM_PROVIDER=heuristic
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
# Agente del Data Lake («Preguntar al Data Lake»): auto = usa el LLM de arriba si LLM_PROVIDER es openai u ollama;
# plantillas = solo reglas, sin LLM. LAKE_LLM_MODEL permite un modelo distinto para generar SQL (vacío = LLM_MODEL).
LAKE_AGENT_MODE=auto
LAKE_LLM_MODEL=
# Modelo multimodal para imágenes (vacío = mismo LLM_MODEL)
VISION_MODEL=
# Umbral de confianza para asignación automática
AI_CONFIDENCE_THRESHOLD=0.75
# Voz: los modelos se descargan la primera vez a un volumen Docker
STT_ENABLED=true
STT_MODEL=small
TTS_ENABLED=true
TTS_VOICE=es_MX-ald-medium

# --- Plataforma de datos ------------------------------------------------
AIRFLOW_ADMIN_PASSWORD=cambia-airflow-admin
LAKE_TIMEZONE=America/Bogota

# --- Antivirus (perfil "clamav") -----------------------------------------
CLAMAV_ENABLED=false

# --- Cloudflare Tunnel (perfil "edge") -----------------------------------
# Token del túnel con nombre (Zero Trust > Networks > Tunnels). NO lo subas a Git.
TUNNEL_TOKEN=
